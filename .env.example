# Local defaults work with everything below unset (SQLite + filesystem
# object store — the development profile). Set these for the
# production-shaped profile: Postgres is the production case store,
# verified end to end in R16 (full-suite parity, migrations on an
# empty database, and the scripts/prod_smoke.py lifecycle walk).

# Postgres case store (compose sets this for the app service):
# DATABASE_URL=postgresql://amlinvestigations:amlinvestigations@localhost:5432/amlinvestigations

# S3-compatible evidence store (SeaweedFS in compose):
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=aml-evidence
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Model gateway (R13): the deployment's own profile is resolved
# at startup — an unknown or unconfigured profile refuses the
# boot, and a live profile selected without its endpoint/key
# refuses loudly at call time. There is no fallback.
# AML_MODEL_PROFILE=offline
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# IN_BOUNDARY_MODEL_URL=
# IN_BOUNDARY_MODEL_API_KEY=

AML_SQLITE_PATH=./data/aml.db
OBJECT_STORE_DIR=./data/evidence-objects
LOG_LEVEL=INFO
